# ==========================================
# Horology Luxury Watches - Environment Variables
# ==========================================
# ⚠️  SECURITY: Copy this file to .env and fill in real values.
#               NEVER commit .env to Git — it's in .gitignore.
#               For production, set these in Vercel Dashboard → Settings → Environment Variables.
# ==========================================

# 1. Supabase Cloud Database & Realtime (Optional - App runs offline/local if omitted)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. Payment Gateway Keys (Optional — PUBLIC keys only, never SECRET keys here)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
VITE_TABBY_PUBLIC_KEY=pk_test_tabby_...

# 3. Notification Service Keys (Optional)
VITE_RESEND_API_KEY=re_123456789...
VITE_ADMIN_WHATSAPP=+966501112233

# 4. Security Settings
# Admin PIN for the dashboard (4–8 digits). Change this before going live!
VITE_ADMIN_PIN=1234
# Set to 'true' to show sandbox test cards in checkout (development only)
# In Vercel production, set to 'false' or leave unset.
VITE_SANDBOX_MODE=false
